# Copy to .env and adjust. Everything here has a working default except the
# location and HA_TOKEN. The .env file is gitignored.

# Dashboard + API.
# Note the host: 0.0.0.0 means anyone on your LAN can control your devices.
# Set it to 127.0.0.1 to restrict access to this machine only.
HOMECONTROL_PORT=9123
HOMECONTROL_HOST=0.0.0.0

# Where the house is. Used only for local sunrise/sunset maths, so that
# "switch the lights on at dusk" works with no internet.
#
# SET THESE. The built-in default is Greenwich, which is a placeholder rather
# than a guess — leave it and sun-based automations will fire at the wrong time.
# The server logs a warning on startup while they are unset.
HOMECONTROL_LAT=51.4779
HOMECONTROL_LON=-0.0015

# Home Assistant. Create the token in HA: profile -> Security -> Long-lived access tokens.
HA_URL=http://127.0.0.1:8123
HA_TOKEN=

# Discovery tuning
DISCOVERY_LISTEN_MS=4000
DISCOVERY_SWEEP_CONCURRENCY=256
DISCOVERY_PORT_TIMEOUT_MS=1500
DISCOVERY_PORT_SOCKETS=96
DISCOVERY_MAX_SUBNET_HOSTS=1024
# Set to false to keep every MAC lookup offline (built-in table only).
DISCOVERY_ONLINE_OUI=true

# debug | info | warn | error
LOG_LEVEL=info
